<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light"><title>Daily digests</title></head>
<body style="margin:0;background:#f4f5f7;">
<div style="max-width:720px;margin:0 auto;padding:16px;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1d2330;font-size:16px;line-height:1.45;">
<a href="index.html" style="font-size:14px;color:#0b5cad;text-decoration:none;">&larr; Research hub</a>
<h1 style="font-size:22px;margin:8px 0 12px;">Daily digests (archive)</h1>
{% if not entries %}<p>No digests yet.</p>{% endif %}
{% for e in entries %}
<a href="{{ e.file }}" style="display:block;text-decoration:none;color:inherit;background:#fff;border:1px solid {{ '#e3a1a1' if e.kind == 'failure' else '#dfe3ea' }};border-radius:8px;padding:12px 14px;margin:10px 0;">
  <div style="font-weight:600;color:{{ '#a02323' if e.kind == 'failure' else '#0b5cad' }};">{{ e.subject }}</div>
  <div style="font-size:13px;color:#5a6475;margin-top:2px;">
    {% if e.kind == 'failure' %}Run failed{% else %}{{ e.n_mine }} for you · {{ e.n_major }} major{% endif %} · {{ e.published }}
  </div>
</a>
{% endfor %}
</div></body></html>
