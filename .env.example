# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never paste these values into chat or commit them.

# ---------------------------------------------------------------- Anthropic
# API key from console.anthropic.com. Use a dedicated workspace with a monthly
# spend limit as a second safety net (see README).
ANTHROPIC_API_KEY=

# Triage model. When Anthropic retires a model, change only this line.
LLM_MODEL=claude-haiku-5-5

# Reasoning effort for triage: low | medium | high. "low" is plenty for scoring
# and keeps output tokens (the expensive part) small. Leave blank to omit.
LLM_EFFORT=low

# Per-token prices in USD per MILLION tokens. These are NOT hard-coded in the
# program: check https://platform.claude.com/docs/en/about-claude/pricing and
# update when the model or its pricing changes. The program refuses to call the
# API if the first two are missing.
# (Values below are the Haiku 5.5 list prices at time of writing: verify them.)
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
# Prompt-cache writes (1.25x input) and reads (0.1x input):
PRICE_CACHE_WRITE_PER_MTOK=0.125
PRICE_CACHE_READ_PER_MTOK=0.01

# Hard COMBINED daily ceiling in USD across all streams. No LLM call is made if it could
# push the day's total past this; remaining items are shown keyword-ranked, with a page note.
# (Optional per-stream caps: `daily_cap_usd` in the stream's block in interests.yaml.)
DAILY_BUDGET_USD=0.15

# Weekly allowance for the journal-club stream only. It draws on this instead of the daily cap.
WEEKLY_EXTRA_USD=0.10

# Journal club may use a stronger model. Leave LLM_MODEL_JOURNAL_CLUB blank to reuse LLM_MODEL (then the
# default prices above apply). If you set a different model, set ITS prices too:
LLM_MODEL_JOURNAL_CLUB=claude-sonnet-5-5
LLM_EFFORT_JOURNAL_CLUB=medium
# Sonnet 5.5 list prices at time of writing: verify at https://platform.claude.com/docs/en/about-claude/pricing
PRICE_JOURNAL_CLUB_INPUT_PER_MTOK=2.00
PRICE_JOURNAL_CLUB_OUTPUT_PER_MTOK=10.00
PRICE_JOURNAL_CLUB_CACHE_WRITE_PER_MTOK=2.50
PRICE_JOURNAL_CLUB_CACHE_READ_PER_MTOK=0.20
# The daily/weekly briefing (paragraph-form summary on the page) is written by a stronger model too:
LLM_MODEL_BRIEFING=claude-sonnet-5-5
LLM_EFFORT_BRIEFING=low
PRICE_BRIEFING_INPUT_PER_MTOK=2.00
PRICE_BRIEFING_OUTPUT_PER_MTOK=10.00
PRICE_BRIEFING_CACHE_WRITE_PER_MTOK=2.50
PRICE_BRIEFING_CACHE_READ_PER_MTOK=0.20
# The tune-up (proposes edits to your learned preferences, from your ratings) also uses the stronger model:
LLM_MODEL_TUNING=claude-sonnet-5-5
LLM_EFFORT_TUNING=low
PRICE_TUNING_INPUT_PER_MTOK=2.00
PRICE_TUNING_OUTPUT_PER_MTOK=10.00
PRICE_TUNING_CACHE_WRITE_PER_MTOK=2.50
PRICE_TUNING_CACHE_READ_PER_MTOK=0.20
# The daily audio briefing (podcast) script is written by Opus (the voices are local Piper, so no TTS key):
LLM_MODEL_PODCAST=claude-opus-5-5
LLM_EFFORT_PODCAST=low
PRICE_PODCAST_INPUT_PER_MTOK=4.00
PRICE_PODCAST_OUTPUT_PER_MTOK=20.00
PRICE_PODCAST_CACHE_WRITE_PER_MTOK=5.00
PRICE_PODCAST_CACHE_READ_PER_MTOK=0.20
# Any stream can override its model the same way: LLM_MODEL_<STREAM>, PRICE_<STREAM>_*  (and name it in the
# stream's `model_env:` in interests.yaml).

# ---------------------------------------------------------------- PubMed
# Optional. Raises the NCBI rate limit from 3 to 10 requests/second.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=

# ---------------------------------------------------------------- Delivery
# web   = publish digests to site/ (served over Tailscale, see README). No email needed.
# email = send via SMTP only.   both = web + email.
DELIVERY=web

# ---------------------------------------------------------------- Email (SMTP)
# Only needed when DELIVERY is "email" or "both"; leave blank for web-only.
# Gmail: smtp.gmail.com, port 587 (STARTTLS) and a 16-character App Password
# (if your account still offers them), or any SMTP relay such as Brevo/SMTP2GO.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# ---------------------------------------------------------------- Misc
# Timezone used for "today", the digest date, and the daily budget day.
LIT_TZ=America/Chicago
